<%- include('./admin_layout_header', { 
  adminTitle: 'Новости и Агрегатор', 
  activeTab: 'news', 
  pageHeader: 'Лента новостей и управление парсингом / рерайтингом',
  stats: stats 
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2 class="admin-card-title">Все опубликованные новости (<%= newsList.length %>)</h2>
      <p style="font-size:0.8125rem; color:#64748b; margin-top:2px;">Автоматический опрос источников: 8:00 МСК ежедневно</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <button type="button" class="btn-admin btn-admin-warning" id="triggerAggregatorBtn">
        ⚡ Собрать и обновить новости сейчас
      </button>
      <a href="/admin/news/new" class="btn-admin btn-admin-primary">
        + Добавить новость вручную
      </a>
    </div>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Превью</th>
        <th>Заголовок новости</th>
        <th>Категория</th>
        <th>Источник</th>
        <th>Просмотры</th>
        <th>Дата публикации</th>
        <th style="text-align: right;">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% newsList.forEach(function(n) { %>
        <tr>
          <td>#<%= n.id %></td>
          <td>
            <img src="<%= n.image || '/images/hero-tennis-ball.jpg' %>" alt="" style="width: 48px; height: 32px; object-fit: cover; border-radius: 4px;">
          </td>
          <td>
            <strong><%= n.title %></strong>
            <div style="font-size: 0.75rem; color: #64748b;">
              <a href="/news/<%= n.category %>/<%= n.slug %>" target="_blank" style="color: var(--admin-primary);">/news/<%= n.category %>/<%= n.slug %> &nearr;</a>
            </div>
          </td>
          <td>
            <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; font-weight: 700; background: #e0f2fe; color: #0369a1;">
              <%= n.category === 'atp' ? 'ATP Тур' : (n.category === 'wta' ? 'WTA Тур' : (n.category === 'grand-slam' ? 'Большой шлем' : (n.category === 'team-russia' ? 'Сборная РФ' : 'Падел'))) %>
            </span>
          </td>
          <td style="font-size: 0.8125rem; color: #64748b;"><%= n.source_name %></td>
          <td><%= n.views %></td>
          <td style="font-size: 0.8125rem; color: #64748b; white-space: nowrap;"><%= n.published_at %></td>
          <td style="text-align: right; white-space: nowrap;">
            <a href="/admin/news/edit/<%= n.id %>" class="btn-admin btn-admin-primary btn-admin-sm">
              ✏️ Редактор
            </a>
            <form action="/admin/news/delete/<%= n.id %>" method="POST" style="display: inline-block;" onsubmit="return confirm('Удалить эту новость?');">
              <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">
                🗑️
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('./admin_layout_footer') %>
