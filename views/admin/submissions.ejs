<%- include('./admin_layout_header', { 
  adminTitle: 'Заявки с форм сайта', 
  activeTab: 'submissions', 
  pageHeader: 'Входящие заявки, обращения и подписки на рассылку',
  stats: stats 
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2 class="admin-card-title">Журнал всех заявок с форм (<%= submissions.length %>)</h2>
      <p style="font-size: 0.8125rem; color: #64748b; margin-top: 2px;">
        Каждая заявка автоматически дублируется на почту администратора <strong>sonicsquad@mail.ru</strong> (на самом сайте адрес строго скрыт).
      </p>
    </div>
  </div>

  <% if (submissions.length === 0) { %>
    <div style="padding: 40px; text-align: center; color: #64748b;">
      Пока нет входящих заявок.
    </div>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Дата и время</th>
          <th>Тип формы</th>
          <th>Имя</th>
          <th>Контактные данные</th>
          <th>Тема и сообщение</th>
          <th>Статус</th>
          <th>Действия</th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(function(sub) { %>
          <tr>
            <td>#<%= sub.id %></td>
            <td style="font-size: 0.8125rem; white-space: nowrap;"><%= sub.created_at %></td>
            <td>
              <span style="font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; font-weight: 700; background: <%= sub.form_type === 'newsletter' ? '#e0f2fe' : '#fef3c7' %>; color: <%= sub.form_type === 'newsletter' ? '#0369a1' : '#b45309' %>;">
                <%= sub.form_type %>
              </span>
            </td>
            <td><strong><%= sub.name || 'Подписчик' %></strong></td>
            <td><code style="background: #f1f5f9; padding: 2px 6px; border-radius: 4px;"><%= sub.contact_info %></code></td>
            <td style="max-width: 320px; word-break: break-word;">
              <strong><%= sub.subject || '' %></strong>
              <% if (sub.message) { %>
                <div style="font-size: 0.775rem; color: #64748b; margin-top: 4px;">
                  <%= sub.message %>
                </div>
              <% } %>
            </td>
            <td>
              <% if (sub.status === 'processed') { %>
                <span style="background: #dcfce7; color: #15803d; font-weight: 800; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem;">
                  ✔ Обработано
                </span>
              <% } else { %>
                <span style="background: #fef3c7; color: #92400e; font-weight: 800; padding: 3px 8px; border-radius: 4px; font-size: 0.75rem;">
                  Новая
                </span>
              <% } %>
            </td>
            <td>
              <div style="display: flex; gap: 6px;">
                <% if (sub.status !== 'processed') { %>
                  <a href="/admin/submissions/process/<%= sub.id %>" class="btn-admin btn-admin-success btn-admin-sm" title="Пометить как обработанную">
                    ✔ Обработано
                  </a>
                <% } %>
                <a href="/admin/submissions/delete/<%= sub.id %>" class="btn-admin btn-admin-danger btn-admin-sm" onclick="return confirm('Удалить эту заявку полностью?')" title="Удалить">
                  🗑️
                </a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('./admin_layout_footer') %>
