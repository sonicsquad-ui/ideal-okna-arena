<%- include('./admin_layout_header', { 
  adminTitle: 'Статьи блога', 
  activeTab: 'blog', 
  pageHeader: 'Управление статьями блога и аналитики',
  stats: stats 
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <h2 class="admin-card-title">Все статьи блога «Чемпион-Теннис»</h2>
    <a href="/admin/blog/new" class="btn-admin btn-admin-primary">
      <span>+ Написать новую статью</span>
    </a>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Превью</th>
        <th>Заголовок статьи</th>
        <th>Рубрика</th>
        <th>Автор</th>
        <th>Просмотры</th>
        <th>Выбор редакции</th>
        <th>Дата</th>
        <th style="text-align: right;">Действия</th>
      </tr>
    </thead>
    <tbody>
      <% articles.forEach(function(a) { %>
        <tr>
          <td>#<%= a.id %></td>
          <td>
            <img src="<%= a.image || '/images/blog-tactics.jpg' %>" alt="" style="width: 48px; height: 32px; object-fit: cover; border-radius: 4px;">
          </td>
          <td>
            <strong><%= a.title %></strong>
            <div style="font-size: 0.75rem; color: #64748b;">
              <a href="/blog/<%= a.category %>/<%= a.slug %>" target="_blank" style="color: var(--admin-primary);">/blog/<%= a.category %>/<%= a.slug %> &nearr;</a>
            </div>
          </td>
          <td>
            <span style="font-size: 0.75rem; padding: 2px 6px; border-radius: 4px; font-weight: 700; background: #fef3c7; color: #b45309;">
              <%= a.category === 'previews' ? 'Превью' : (a.category === 'tactics' ? 'Тактика' : (a.category === 'interviews' ? 'Интервью' : 'Обзоры')) %>
            </span>
          </td>
          <td><%= a.author_name %></td>
          <td><strong><%= a.views %></strong></td>
          <td>
            <% if (a.is_editors_choice) { %>
              <span style="color: #16a34a; font-weight: 800;">⭐ Да</span>
            <% } else { %>
              <span style="color: #94a3b8;">—</span>
            <% } %>
          </td>
          <td style="font-size: 0.8125rem; color: #64748b;"><%= a.published_at %></td>
          <td style="text-align: right; white-space: nowrap;">
            <a href="/admin/blog/edit/<%= a.id %>" class="btn-admin btn-admin-primary btn-admin-sm">
              ✏️ Редактор
            </a>
            <form action="/admin/blog/delete/<%= a.id %>" method="POST" style="display: inline-block;" onsubmit="return confirm('Удалить эту статью?');">
              <button type="submit" class="btn-admin btn-admin-danger btn-admin-sm">
                🗑️
              </button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('./admin_layout_footer') %>
