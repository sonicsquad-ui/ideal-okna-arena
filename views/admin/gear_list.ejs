<%- include('./admin_layout_header', { 
  adminTitle: 'Ракетки и Экипировка 2026', 
  activeTab: 'gear', 
  pageHeader: 'Управление экипировкой и ракетками 2026',
  stats: stats 
}) %>

<div class="admin-card">
  <div class="admin-card-header">
    <h2 class="admin-card-title">Все обзоры ракеток и экипировки (<%= gear.length %>)</h2>
    <a href="/admin/gear/new" class="btn-admin btn-admin-primary">+ Добавить модель</a>
  </div>

  <table class="admin-table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Фото</th>
        <th>Бренд и модель</th>
        <th>Категория</th>
        <th>Цена</th>
        <th>Рейтинг</th>
        <th>Действия</th>
      </tr>
    </thead>
    <tbody>
      <% gear.forEach(function(g) { %>
        <tr>
          <td>#<%= g.id %></td>
          <td><img src="<%= g.image %>" style="width: 50px; height: 36px; object-fit: cover; border-radius: 4px;" alt=""></td>
          <td><strong><%= g.brand %> <%= g.title %></strong></td>
          <td><%= g.category %></td>
          <td><strong style="color: #c84c1f;"><%= g.price %></strong></td>
          <td>⭐ <%= g.rating %>/10</td>
          <td>
            <a href="/admin/gear/edit/<%= g.id %>" class="btn-admin btn-admin-primary btn-admin-sm">✏️ Редактор</a>
            <a href="/admin/gear/delete/<%= g.id %>" class="btn-admin btn-admin-danger btn-admin-sm" onclick="return confirm('Удалить эту модель?')">🗑️</a>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<%- include('./admin_layout_footer') %>
