<%- include('./admin_layout_header', { 
  adminTitle: 'Главная панель', 
  activeTab: 'dashboard', 
  pageHeader: 'Сводка и Управление сайтом Champion-Tennis.ru',
  stats: stats 
}) %>

<!-- Stat Cards Grid -->
<div class="admin-stats-grid">
  <div class="stat-card">
    <div class="stat-card-title">Страницы сайта</div>
    <div class="stat-card-val"><%= stats.pagesCount %></div>
    <div class="stat-card-desc"><a href="/admin/pages" style="color:var(--admin-primary); font-weight:700;">Управление страницами &rarr;</a></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-title">Статьи блога</div>
    <div class="stat-card-val"><%= stats.articlesCount %></div>
    <div class="stat-card-desc"><a href="/admin/blog" style="color:var(--admin-primary); font-weight:700;">Редактор статей &rarr;</a></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-title">Новости в базе</div>
    <div class="stat-card-val"><%= stats.newsCount %></div>
    <div class="stat-card-desc"><a href="/admin/news" style="color:var(--admin-primary); font-weight:700;">Лента и Агрегатор &rarr;</a></div>
  </div>

  <div class="stat-card">
    <div class="stat-card-title">Заявки с форм</div>
    <div class="stat-card-val"><%= stats.submissionsCount %></div>
    <div class="stat-card-desc" style="color:#059669;">Дублируются на почту администратора</div>
  </div>
</div>

<!-- News Aggregator Control Box -->
<div class="admin-card" style="border-left: 4px solid var(--admin-primary);">
  <div class="admin-card-header">
    <h2 class="admin-card-title">🤖 Автообновление новостей (Cron 8:00 МСК)</h2>
    <div>
      <button type="button" class="btn-admin btn-admin-primary" id="triggerAggregatorBtn">
        ⚡ Собрать и обновить новости сейчас
      </button>
    </div>
  </div>
  <p style="font-size: 0.875rem; color: #475569; line-height: 1.6; margin-bottom: 14px;">
    Новости собираются из спортивных источников (Sport-Express, Sports.ru, Championat, RIA, TennisBB). 
    Заголовки и тексты автоматически переписываются с созданием уникальных URL (транслитерация).
  </p>
  <div style="background: #f8fafc; padding: 12px 16px; border-radius: 6px; font-size: 0.8125rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
    <div>
      <strong>Статус Cron расписания:</strong> 
      <span style="color: #16a34a; font-weight: 700;">Активен (ежедневно в 08:00 по Москве)</span>
    </div>
    <div id="aggregatorStatusBadge" style="color: #0284c7; font-weight: 600;">
      Последний запуск: <%= cronStatus.last_run_msk || 'Не зафиксирован' %>
    </div>
  </div>
</div>

<!-- Recent Form Submissions Quick View -->
<div class="admin-card">
  <div class="admin-card-header">
    <h2 class="admin-card-title">📬 Последние заявки и подписки с сайта</h2>
    <a href="/admin/submissions" class="btn-admin btn-admin-secondary btn-admin-sm">Все заявки &rarr;</a>
  </div>

  <% if (recentSubmissions.length === 0) { %>
    <p style="color: #64748b; font-size: 0.875rem;">Заявок пока нет. Все новые заявки с форм контактов и подписки на рассылку будут отображаться здесь и дублироваться на почту.</p>
  <% } else { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Дата (МСК)</th>
          <th>Тип формы</th>
          <th>Имя</th>
          <th>Контакт</th>
          <th>Тема / Запрос</th>
          <th>Статус отправки</th>
        </tr>
      </thead>
      <tbody>
        <% recentSubmissions.forEach(function(sub) { %>
          <tr>
            <td style="white-space: nowrap; font-size: 0.775rem;"><%= sub.created_at %></td>
            <td>
              <span style="background: #e2e8f0; font-size: 0.75rem; font-weight: 700; padding: 2px 6px; border-radius: 4px;">
                <%= sub.form_type %>
              </span>
            </td>
            <td><strong><%= sub.name || 'Аноним' %></strong></td>
            <td><code><%= sub.contact_info %></code></td>
            <td><%= sub.subject || sub.message || 'Подписка на рассылку' %></td>
            <td>
              <span style="color: #16a34a; font-weight: 700; font-size: 0.75rem;">
                ✔ Переслано на sonicsquad@mail.ru
              </span>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('./admin_layout_footer') %>
