<header class="site-header">
  <!-- Top ticker bar -->
  <div class="top-ticker-bar">
    <div class="container top-ticker-inner">
      <div class="ticker-left">
        <span class="ticker-badge">Молния</span>
        <span class="ticker-content">
          <%= typeof globalSettings !== 'undefined' && globalSettings.header && globalSettings.header.ticker_text ? globalSettings.header.ticker_text : '🔥 LIVE: Рим ATP 1000 — Медведев в полуфинале • Мирра Андреева ворвалась в топ-6 WTA • Бум падела в РФ' %>
        </span>
      </div>
      <div class="ticker-right">
        <span class="header-date">
          <svg style="width:13px; height:13px; vertical-align:-1px; margin-right:4px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          23 сентября 2026, Москва
        </span>
        <div class="top-socials">
          <a href="https://t.me/champion_tennis_ru" target="_blank" rel="noopener" class="top-social-link" title="Telegram-канал">
            <svg style="width:13px; height:13px;" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69.01-.03.01-.14-.07-.19-.08-.05-.19-.02-.27 0-.12.03-1.99 1.27-5.62 3.72-.53.36-1.01.54-1.44.53-.47-.01-1.38-.27-2.06-.49-.83-.27-1.49-.42-1.43-.88.03-.24.37-.49 1.02-.75 3.99-1.74 6.66-2.89 8.01-3.46 3.81-1.61 4.6-.19 4.6 1.48z"/></svg>
          </a>
          <a href="https://vk.com/champion_tennis_ru" target="_blank" rel="noopener" class="top-social-link" title="ВКонтакте">
            <svg style="width:14px; height:14px;" fill="currentColor" viewBox="0 0 24 24"><path d="M15.684 0H8.316C3.724 0 0 3.724 0 8.316v7.368C0 20.276 3.724 24 8.316 24h7.368C20.276 24 24 20.276 24 15.684V8.316C24 3.724 20.276 0 15.684 0zm3.602 17.533h-2.144c-.812 0-1.06-.645-2.52-2.115-1.274-1.242-1.84-1.398-2.155-1.398-.439 0-.566.126-.566.732v1.94c0 .524-.168.841-1.554.841-2.29 0-4.836-1.391-6.626-3.98-2.692-3.79-3.44-6.643-3.44-7.234 0-.324.126-.624.743-.624h2.145c.556 0 .768.253.98.849 1.082 3.125 2.89 5.86 3.633 5.86.282 0 .408-.126.408-.82v-3.21c-.085-1.472-.862-1.597-.862-2.122 0-.248.204-.498.535-.498h3.364c.467 0 .637.247.637.806v4.331c0 .466.204.623.34.623.28 0 .515-.157 1.047-.69 1.625-1.821 2.784-4.526 2.784-4.526.155-.323.411-.544.966-.544h2.144c.648 0 .788.334.648.806-.264 1.205-2.83 4.802-2.955 5.011-.274.425-.38.618 0 1.125.267.364 1.157 1.135 1.748 1.821 1.096 1.258 1.939 2.316 2.164 3.044.238.745-.119 1.133-.872 1.133z"/></svg>
          </a>
          <a href="/rss.xml" class="top-social-link" title="RSS Новостная лента">
            <svg style="width:13px; height:13px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 5c7.18 0 13 5.82 13 13M6 11a7 7 0 017 7m-6 0a1 1 0 11-2 0 1 1 0 012 0z"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Main header line -->
  <div class="container main-header-row">
    <!-- Brand Logo (Пункт 6: только ЧЕМПИОН-ТЕННИС без домена) -->
    <a href="/" class="brand-logo" title="На главную Champion-Tennis.ru">
      <div class="brand-crest" style="width:44px; height:44px; min-width:44px; min-height:44px; max-width:44px; max-height:44px; overflow:hidden;">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:26px; height:26px; max-width:26px; max-height:26px; display:block;">
          <circle cx="12" cy="12" r="10" stroke="#ccff00" stroke-width="2"/>
          <path d="M4.93 4.93c4.2 4.2 4.2 10.94 0 15.14" stroke="#ffffff" stroke-width="1.8"/>
          <path d="M19.07 4.93c-4.2 4.2-4.2 10.94 0 15.14" stroke="#ffffff" stroke-width="1.8"/>
        </svg>
      </div>
      <div class="brand-text">
        <div class="brand-name">Чемпион-<span>Теннис</span></div>
      </div>
    </a>

    <!-- Main Navigation Menu -->
    <nav class="header-nav">
      <a href="/news" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'news' ? 'active' : '' %>">Новости</a>
      <a href="/tournaments" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'tournaments' ? 'active' : '' %>">Турниры и календарь</a>
      <a href="/rankings" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'rankings' ? 'active' : '' %>">Рейтинги ATP/WTA</a>
      <a href="/players" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'players' ? 'active' : '' %>">Игроки</a>
      <a href="/blog" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'blog' ? 'active' : '' %>">Аналитика и Блог</a>
      <a href="/gear" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'gear' ? 'active' : '' %>">Экипировка 2026</a>
      <a href="/about" class="nav-link <%= typeof activeNav !== 'undefined' && activeNav === 'about' ? 'active' : '' %>">О проекте</a>
    </nav>

    <!-- Header Actions: Кнопка поиска только значком лупы (Требование 3) + Гамбургер на мобильных (Требование 4) -->
    <div class="header-actions">
      <!-- Кнопка поиска по сайту: значок лупы без текста, тултип при наведении (Требование 3) -->
      <button class="search-btn-trigger js-search-trigger" type="button" aria-label="Поиск по сайту" title="Поиск по сайту">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.3" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </button>

      <!-- Mobile Hamburger Button: строго рядом с лупой на экранах <= 992px (Требование 4) -->
      <button class="mobile-menu-toggle" id="mobileMenuToggle" type="button" aria-label="Открыть мобильное меню" title="Меню сайта">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0f172a" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Subnav Category Bar (Пункт 15: фильтрация новостей по категориям) -->
  <div class="category-subnav">
    <div class="container subnav-inner">
      <a href="/news" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'all' ? 'active' : '' %>">Все новости</a>
      <a href="/news/atp" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'atp' ? 'active' : '' %>">
        ATP Тур <span class="subnav-badge">Мужчины</span>
      </a>
      <a href="/news/wta" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'wta' ? 'active' : '' %>">
        WTA Тур <span class="subnav-badge" style="background:#9333ea;">Женщины</span>
      </a>
      <a href="/news/grand-slam" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'grand-slam' ? 'active' : '' %>">
        Большой шлем
      </a>
      <a href="/news/team-russia" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'team-russia' ? 'active' : '' %>">
        🇷🇺 Сборная РФ / РТТ
      </a>
      <a href="/news/padel-pickleball" class="subnav-item <%= typeof activeCategory !== 'undefined' && activeCategory === 'padel-pickleball' ? 'active' : '' %>">
        🎾 Падел &amp; Пиклбол
      </a>
      <a href="/tournaments" class="subnav-item <%= typeof activeNav !== 'undefined' && activeNav === 'tournaments' ? 'active' : '' %>">Календарь сезона</a>
      <a href="/gear" class="subnav-item <%= typeof activeNav !== 'undefined' && activeNav === 'gear' ? 'active' : '' %>">Ракетки 2026</a>
      <a href="/glossary" class="subnav-item <%= typeof activeNav !== 'undefined' && activeNav === 'glossary' ? 'active' : '' %>">Глоссарий</a>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer (Пункт 17) -->
<div class="drawer-overlay" id="drawerOverlay"></div>
<aside class="mobile-drawer" id="mobileDrawer">
  <div class="mobile-drawer-header">
    <div class="brand-name" style="font-size:1.15rem;">Чемпион-<span>Теннис</span></div>
    <button id="mobileDrawerClose" style="background:none; border:none; font-size:1.6rem; cursor:pointer; color:#0f172a; padding:4px 8px;">&times;</button>
  </div>
  <nav class="mobile-drawer-nav">
    <a href="/" class="drawer-link">Главная страница</a>
    <a href="/news" class="drawer-link">Лента новостей</a>
    <a href="/news/atp" class="drawer-link" style="padding-left:24px;">— ATP Тур</a>
    <a href="/news/wta" class="drawer-link" style="padding-left:24px;">— WTA Тур</a>
    <a href="/news/grand-slam" class="drawer-link" style="padding-left:24px;">— Большой шлем</a>
    <a href="/news/team-russia" class="drawer-link" style="padding-left:24px;">— Сборная России</a>
    <a href="/news/padel-pickleball" class="drawer-link" style="padding-left:24px;">— Падел и Пиклбол</a>
    <a href="/tournaments" class="drawer-link">Турниры и календарь 2026</a>
    <a href="/rankings" class="drawer-link">Рейтинги ATP / WTA</a>
    <a href="/players" class="drawer-link">Игроки мирового тура</a>
    <a href="/blog" class="drawer-link">Аналитика и Блог</a>
    <a href="/gear" class="drawer-link">Ракетки и Экипировка 2026</a>
    <a href="/glossary" class="drawer-link">Глоссарий терминов</a>
    <a href="/about" class="drawer-link">О проекте и Редакция</a>
    <a href="/contacts" class="drawer-link">Контакты и Реклама</a>
    <a href="/sitemap" class="drawer-link">Карта сайта</a>
  </nav>
</aside>
