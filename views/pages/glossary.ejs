<%- include('../partials/head', { title: 'Глоссарий теннисных терминов — Чемпион-Теннис' }) %>
<%- include('../partials/header', { activeNav: 'gear' }) %>
<%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>

<main class="page-main">
  <div class="container">
    
    <div class="section-title-bar" style="margin-bottom: 24px;">
      <div>
        <h1 class="section-heading" style="font-size: 1.75rem;">
          <span class="heading-bar"></span>
          <span>Глоссарий теннисных терминов от А до Я</span>
        </h1>
        <p style="font-size: 0.875rem; color: #64748b; margin-top: 4px;">
          Интерактивный справочник теннисной терминологии, сленга комментаторов, судейских понятий и элементов техники.
        </p>
      </div>
    </div>

    <!-- Alphabet Filter Bar -->
    <div style="background: white; border-radius: 10px; border: 1px solid var(--border); padding: 14px 20px; margin-bottom: 28px; display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
      <span style="font-size: 0.8125rem; font-weight: 700; color: #64748b; margin-right: 8px;">Алфавитный указатель:</span>
      <button class="subnav-item active js-gloss-letter" data-letter="ALL">Все термины</button>
      <% letters.forEach(function(l) { %>
        <button class="subnav-item js-gloss-letter" data-letter="<%= l %>"><%= l %></button>
      <% }); %>
    </div>

    <!-- Glossary List -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px;">
      <% glossary.forEach(function(item) { %>
        <div class="glossary-item" data-letter="<%= item.letter %>" style="background: white; border-radius: 8px; border: 1px solid var(--border); padding: 20px; box-shadow: var(--shadow-sm);">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
            <h3 style="font-size: 1.2rem; font-weight: 800; color: var(--primary-dark);">
              <%= item.term %>
            </h3>
            <span style="font-size: 0.75rem; color: #94a3b8; font-style: italic;"><%= item.term_en %></span>
          </div>
          <p style="font-size: 0.875rem; color: #334155; line-height: 1.55; margin-bottom: 12px;">
            <%= item.definition %>
          </p>
          <% if (item.example) { %>
            <div style="font-size: 0.775rem; color: #64748b; background: #f8fafc; padding: 8px 12px; border-radius: 4px; border-left: 3px solid var(--accent-clay);">
              <strong>Пример в игре:</strong> «<%= item.example %>»
            </div>
          <% } %>
        </div>
      <% }); %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
