<%- include('../partials/head', { title: 'Аналитика и Мнения — Блог «Чемпион-Теннис»' }) %>
<%- include('../partials/header', { activeNav: 'blog' }) %>
<%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>

<main class="page-main">
  <div class="container">
    
    <div class="section-title-bar" style="margin-bottom: 24px;">
      <div>
        <h1 class="section-heading" style="font-size: 1.75rem;">
          <span class="heading-bar" style="background: var(--accent-clay);"></span>
          <span>Аналитика и Мнения — Экспертный блог</span>
        </h1>
        <p style="font-size: 0.875rem; color: #64748b; margin-top: 4px;">
          Глубокие тактические разборы, прогнозы на турниры Большого шлема, интервью со звездами и экспертные тесты экипировки.
        </p>
      </div>
    </div>

    <!-- Category Tabs -->
    <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 28px; padding-bottom: 12px; border-bottom: 1px solid var(--border);">
      <a href="/blog" class="subnav-item <%= currentCategory === 'all' ? 'active' : '' %>">Все статьи блога</a>
      <a href="/blog/previews" class="subnav-item <%= currentCategory === 'previews' ? 'active' : '' %>">Превью и прогнозы</a>
      <a href="/blog/tactics" class="subnav-item <%= currentCategory === 'tactics' ? 'active' : '' %>">Разбор тактики и техники</a>
      <a href="/blog/interviews" class="subnav-item <%= currentCategory === 'interviews' ? 'active' : '' %>">Эксклюзивные интервью</a>
      <a href="/blog/reviews" class="subnav-item <%= currentCategory === 'reviews' ? 'active' : '' %>">Обзоры турниров и экипировки</a>
    </div>

    <!-- Articles Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 28px;">
      <% articles.forEach(function(art) { %>
        <article class="editors-card" style="box-shadow: var(--shadow-sm);">
          <a href="/blog/<%= art.category %>/<%= art.slug %>">
            <img src="<%= art.image || '/images/blog-tactics.jpg' %>" alt="<%= art.title %>" class="editors-img" loading="lazy">
          </a>
          <div class="editors-body">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px;">
              <div class="editors-author">
                <img src="<%= art.author_avatar || '/images/author-coach.jpg' %>" alt="<%= art.author_name %>">
                <div>
                  <div style="font-size:0.8125rem; font-weight:700;"><%= art.author_name %></div>
                  <div style="font-size:0.7rem; color:#94a3b8;"><%= art.author_role %></div>
                </div>
              </div>
              <span style="font-size:0.75rem; color:#64748b; background:#f1f5f9; padding:2px 8px; border-radius:4px;">
                ⏱️ <%= art.reading_time %> мин
              </span>
            </div>

            <h2 class="editors-title">
              <a href="/blog/<%= art.category %>/<%= art.slug %>"><%= art.title %></a>
            </h2>
            <p class="editors-snippet"><%= art.excerpt %></p>
            
            <div style="margin-top: auto; padding-top: 14px; border-top: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 0.75rem; color: #94a3b8;">👁️ <%= art.views %> просмотров</span>
              <a href="/blog/<%= art.category %>/<%= art.slug %>" class="btn-read-more">
                <span>Читать лонгрид &rarr;</span>
              </a>
            </div>
          </div>
        </article>
      <% }); %>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
