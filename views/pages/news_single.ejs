<%- include('../partials/head', { 
  title: newsItem.meta_title || (newsItem.title + ' — Чемпион-Теннис'),
  meta_description: newsItem.meta_description || newsItem.excerpt,
  og_image: newsItem.image
}) %>

<%- include('../partials/header', { activeNav: 'news', activeCategory: newsItem.category }) %>
<%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>

<main class="page-main">
  <div class="container">
    <article class="article-container">
      
      <header class="article-header">
        <div style="display: flex; gap: 8px; margin-bottom: 12px;">
          <span class="category-tag <%= newsItem.category %>" style="position: static;">
            <%= categoryLabel %>
          </span>
          <span style="font-size: 0.75rem; background: #f1f5f9; padding: 3px 8px; border-radius: 4px; color: #64748b; font-weight: 600;">
            Первоисточник: <%= newsItem.source_name %>
          </span>
        </div>

        <h1 class="article-title-main"><%= newsItem.title %></h1>

        <div class="article-meta-bar">
          <div class="article-author-info">
            <div class="author-name-text">Автор: <%= newsItem.author %></div>
            <span style="color: #cbd5e1;">•</span>
            <div>Опубликовано: <%= newsItem.published_at_formatted %> (МСК)</div>
          </div>
          <div style="display: flex; gap: 14px; align-items: center;">
            <span>👁️ <strong><%= newsItem.views %></strong> просмотров</span>
          </div>
        </div>
      </header>

      <% if (newsItem.image) { %>
        <img src="<%= newsItem.image %>" alt="<%= newsItem.title %>" class="article-hero-cover">
      <% } %>

      <div class="article-content">
        <!-- Short excerpt lead -->
        <p style="font-size: 1.15rem; font-weight: 600; color: #334155; line-height: 1.6; border-left: 4px solid var(--primary); padding-left: 14px; margin-bottom: 24px;">
          <%= newsItem.excerpt %>
        </p>

        <!-- Full unique content -->
        <%- newsItem.content %>
      </div>

      <!-- Social sharing & Logical Cross-linking -->
      <div class="article-sharing-bar">
        <div style="font-weight: 700; font-size: 0.875rem; color: #334155;">Поделиться материалом:</div>
        <div class="social-share-buttons">
          <a href="https://t.me/share/url?url=<%= encodeURIComponent('https://champion-tennis.ru/news/' + newsItem.category + '/' + newsItem.slug) %>&text=<%= encodeURIComponent(newsItem.title) %>" target="_blank" rel="noopener" class="share-btn">
            <span>✈️ Telegram</span>
          </a>
          <a href="https://vk.com/share.php?url=<%= encodeURIComponent('https://champion-tennis.ru/news/' + newsItem.category + '/' + newsItem.slug) %>" target="_blank" rel="noopener" class="share-btn">
            <span>🔵 ВКонтакте</span>
          </a>
          <a href="https://api.whatsapp.com/send?text=<%= encodeURIComponent(newsItem.title + ' https://champion-tennis.ru/news/' + newsItem.category + '/' + newsItem.slug) %>" target="_blank" rel="noopener" class="share-btn">
            <span>🟢 WhatsApp</span>
          </a>
          <button type="button" class="share-btn js-copy-link">
            <span>🔗 Скопировать ссылку</span>
          </button>
        </div>
      </div>

      <!-- Logical Interlinking: Related News -->
      <% if (relatedNews && relatedNews.length > 0) { %>
        <div style="margin-top: 40px; padding-top: 28px; border-top: 2px solid var(--border);">
          <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 18px; color: var(--text-main);">
            Читайте также по теме:
          </h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px;">
            <% relatedNews.forEach(function(rel) { %>
              <div style="background: #f8fafc; border: 1px solid var(--border); border-radius: 8px; padding: 14px;">
                <div style="font-size: 0.75rem; color: #94a3b8; margin-bottom: 4px;">
                  <%= rel.published_at_formatted %>
                </div>
                <a href="/news/<%= rel.category %>/<%= rel.slug %>" style="font-weight: 700; font-size: 0.9375rem; color: var(--text-main); line-height: 1.35; display: block;">
                  <%= rel.title %>
                </a>
              </div>
            <% }); %>
          </div>
        </div>
      <% } %>

    </article>
  </div>
</main>

<%- include('../partials/footer') %>
