<%- include('../partials/head', { title: 'Экипировка, Ракетки и Любительский теннис — Чемпион-Теннис' }) %>
<%- include('../partials/header', { activeNav: 'gear' }) %>
<%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>

<main class="page-main">
  <div class="container">
    
    <div class="section-title-bar" style="margin-bottom: 24px;">
      <div>
        <h1 class="section-heading" style="font-size: 1.75rem;">
          <span class="heading-bar"></span>
          <span>Любительский теннис и Экипировка</span>
        </h1>
        <p style="font-size: 0.875rem; color: #64748b; margin-top: 4px;">
          Профессиональные тесты ракеток, подбор струн, спортивная обувь, биомеханические упражнения и защита суставов.
        </p>
      </div>

      <div>
        <a href="/glossary" class="btn-admin btn-admin-primary">
          <span>📖 Глоссарий терминов &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Section 1: Equipment Reviews (Affiliate Rackets & Shoes) -->
    <section style="margin-bottom: 48px;">
      <div class="section-title-bar" style="margin-bottom: 20px;">
        <h2 class="section-heading" style="font-size: 1.35rem;">
          <span>🎾 Флагманские ракетки и обувь 2026 года</span>
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 28px;">
        <% gearList.forEach(function(item) { %>
          <div style="background: white; border-radius: 12px; border: 1px solid var(--border); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
            <div style="aspect-ratio: 16/10; overflow: hidden; background: #0f172a;">
              <img src="<%= item.image %>" alt="<%= item.title %>" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            
            <div style="padding: 20px; display: flex; flex-direction: column; flex: 1;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                <span style="font-size: 0.75rem; font-weight: 700; text-transform: uppercase; background: var(--primary-subtle); color: var(--primary); padding: 2px 8px; border-radius: 4px;">
                  <%= item.brand %>
                </span>
                <span style="font-size: 1.15rem; font-weight: 800; color: var(--accent-clay);">
                  <%= item.price %>
                </span>
              </div>

              <h3 style="font-size: 1.125rem; font-weight: 800; margin-bottom: 12px; line-height: 1.35;">
                <%= item.title %>
              </h3>

              <!-- Specs list -->
              <div style="background: #f8fafc; border-radius: 6px; padding: 10px 12px; font-size: 0.8125rem; margin-bottom: 16px;">
                <% for (let [key, val] of Object.entries(item.specs)) { %>
                  <div style="display: flex; justify-content: space-between; padding: 3px 0; border-bottom: 1px dashed #e2e8f0;">
                    <span style="color: #64748b;"><%= key %>:</span>
                    <strong style="color: #0f172a;"><%= val %></strong>
                  </div>
                <% } %>
              </div>

              <!-- Pros & Cons -->
              <% if (item.pros_cons && item.pros_cons.pros) { %>
                <div style="font-size: 0.8rem; margin-bottom: 16px;">
                  <div style="color: #16a34a; font-weight: 700; margin-bottom: 4px;">Плюсы:</div>
                  <% item.pros_cons.pros.forEach(function(p) { %>
                    <div style="color: #334155; margin-bottom: 2px;">✔ <%= p %></div>
                  <% }); %>
                </div>
              <% } %>

              <div style="margin-top: auto; padding-top: 14px;">
                <a href="<%= item.affiliate_url %>" class="btn-admin btn-admin-primary" style="width: 100%; justify-content: center; padding: 10px 16px;">
                  <span><%= item.affiliate_btn_text %> &rarr;</span>
                </a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>

    <!-- Section 2: Technique & Tactics for Amateurs -->
    <section style="background: white; border-radius: 12px; border: 1px solid var(--border); padding: 28px; margin-bottom: 48px;">
      <h2 style="font-size: 1.35rem; font-weight: 800; margin-bottom: 14px; color: var(--text-main);">
        💡 Техника и тактика для любителей (Советы тренеров)
      </h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px;">
        <div style="background: #f8fafc; border-radius: 8px; padding: 18px; border: 1px solid #e2e8f0;">
          <h4 style="font-weight: 800; font-size: 1rem; margin-bottom: 8px;">1. Позиция ног и точка контакта</h4>
          <p style="font-size: 0.875rem; color: #475569; line-height: 1.5;">
            Главная ошибка любителей — удар по мячу, который уже опустился ниже пояса. Встречайте мяч на восходящей траектории перед собой, согнув колени под 110°.
          </p>
        </div>
        <div style="background: #f8fafc; border-radius: 8px; padding: 18px; border: 1px solid #e2e8f0;">
          <h4 style="font-weight: 800; font-size: 1rem; margin-bottom: 8px;">2. Выбор натяжки струн</h4>
          <p style="font-size: 0.875rem; color: #475569; line-height: 1.5;">
            Не натягивайте полиэстеровые жесткие струны сильнее 24 кг. Для комфорта и сохранения локтя комбинируйте полиэстер с мягким мультифиламентом (гибрид 23/22 кг).
          </p>
        </div>
        <div style="background: #f8fafc; border-radius: 8px; padding: 18px; border: 1px solid #e2e8f0;">
          <h4 style="font-weight: 800; font-size: 1rem; margin-bottom: 8px;">3. Тактика парного тенниса</h4>
          <p style="font-size: 0.875rem; color: #475569; line-height: 1.5;">
            В парной игре 70% очков выигрываются у сетки. Не оставайтесь вдвоем на задней линии: атакуйте по центру («в дыру между игроками») для исключения угловых обводок.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Injury Prevention & Rehabilitation -->
    <section style="background: linear-gradient(135deg, #073a21 0%, #0a5c36 100%); color: white; border-radius: 12px; padding: 32px; margin-bottom: 48px;">
      <div style="max-width: 800px;">
        <span style="background: var(--accent-yellow); color: #074025; font-weight: 800; font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; text-transform: uppercase;">
          Здоровье и долголетие на корте
        </span>
        <h2 style="font-size: 1.75rem; font-weight: 800; margin: 12px 0 10px;">
          Профилактика «теннисного локтя» и укрепление связок
        </h2>
        <p style="color: #e2e8f0; font-size: 0.9375rem; line-height: 1.6; margin-bottom: 20px;">
          Латеральный эпикондилит возникает из-за вибрационных микроударов при децентрированных попаданиях. Наш комплекс специальных упражнений с эспандерами и массажным валиком позволяет предотвратить воспаление сухожилий и играть без боли годами.
        </p>
        <a href="/blog/reviews/profilaktika-tipichnykh-tennisnykh-travm-uprazhneniya-lokot-plecho-koleni" class="btn-cta-submit" style="display: inline-block; text-decoration: none;">
          Читать полный комплекс упражнений с иллюстрациями &rarr;
        </a>
      </div>
    </section>

  </div>
</main>

<%- include('../partials/footer') %>
