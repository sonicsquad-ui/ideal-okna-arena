<%- include('../partials/head', { title: page.meta_title || 'О проекте и Редакция — Чемпион-Теннис' }) %>
<%- include('../partials/header', { activeNav: 'about' }) %>
<%- include('../partials/breadcrumbs', { breadcrumbs: breadcrumbs }) %>

<main class="page-main">
  <div class="container">
    <article class="article-container" style="max-width: 960px;">
      <header class="article-header">
        <h1 class="article-title-main"><%= page.title %></h1>
        <div class="article-meta-bar">
          <div>Редакционный совет портала «Чемпион-Теннис»</div>
          <div>Обновлено: 2026 год</div>
        </div>
      </header>

      <div class="article-content" style="font-size: 1.05rem; line-height: 1.75; color: #1e293b;">
        <%- page.content %>
      </div>

      <!-- Форма обратной связи для раздела О проекте (Пункт 9) -->
      <div class="feedback-embed-card" style="margin-top: 40px; padding: 28px; background: #f8fafc; border: 1px solid var(--border); border-radius: 10px;">
        <h3 style="font-size: 1.25rem; font-weight: 800; color: #074025; margin: 0 0 8px 0;">
          Написать в редакцию «Чемпион-Теннис»
        </h3>
        <p style="font-size: 0.875rem; color: #64748b; margin: 0 0 20px 0;">
          Предложить тему статьи, прислать новость или связаться с авторами портала:
        </p>
        <form id="contactForm" style="display: flex; flex-direction: column; gap: 14px;">
          <input type="hidden" name="form_type" value="Вопрос в редакцию (О проекте)">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px;">
            <input type="text" name="name" class="cta-input" placeholder="Ваше имя" required style="border: 1px solid #cbd5e1; background: white; color: #0f172a;">
            <input type="text" name="contact" class="cta-input" placeholder="Ваш Email или телефон" required style="border: 1px solid #cbd5e1; background: white; color: #0f172a;">
          </div>
          <input type="text" name="subject" class="cta-input" value="Письмо главному редактору" required style="border: 1px solid #cbd5e1; background: white; color: #0f172a;">
          <textarea name="message" class="cta-input" rows="4" placeholder="Текст вашего сообщения..." required style="border: 1px solid #cbd5e1; background: white; color: #0f172a;"></textarea>
          <button type="submit" class="btn-cta-submit" style="border: none; padding: 12px; font-weight: 700;">
            Отправить письмо в редакцию &rarr;
          </button>
          <div style="font-size: 0.75rem; color: #94a3b8; text-align: center;">
            Нажимая кнопку, вы соглашаетесь с <a href="/privacy-policy" style="text-decoration: underline;">Политикой конфиденциальности</a>.
          </div>
        </form>
      </div>
    </article>
  </div>
</main>

<%- include('../partials/footer') %>
