# ==============================================================================
# Champion-Tennis.ru — .htaccess конфигурация для хостинга REG.RU
# ==============================================================================

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Защита базы данных и скрытых файлов
  <FilesMatch "\.(db|sqlite|sqlite3|env|ini|log|sql)$">
    Order deny,allow
    Deny from all
  </FilesMatch>

  # Маршрутизация на админку
  RewriteRule ^admin/?$ admin.php [L,QSA]
  RewriteRule ^admin/(.*)$ admin.php?route=$1 [L,QSA]

  # Автоматический мост для статики (css, js, images):
  # Если файлы лежат в /public/, но браузер запрашивает без /public/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
  RewriteRule ^(.*)$ public/$1 [L]

  RewriteRule ^css/(.*)$ public/css/$1 [L]
  RewriteRule ^js/(.*)$ public/js/$1 [L]
  RewriteRule ^images/(.*)$ public/images/$1 [L]
  RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

  # Отдаем существующие файлы напрямую
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Все остальные запросы отправляем на index.php
  RewriteRule ^(.*)$ index.php?url=$1 [L,QSA]
</IfModule>

# GZIP сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/rss+xml
</IfModule>

# Кэширование статических файлов
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
